# API 오리진. 개발은 비워 두면 vite 프록시(/api·/bff → BFF)로 보내요.
# 배포처럼 백엔드가 CORS를 열어 둔 곳은 오리진을 적어요(예: https://api.example.com). 경로 /api/v1은 붙이지 않아요.
VITE_API_BASE_URL=
# 개발 프록시가 보낼 BFF 주소 (기본 http://localhost:8787). 백엔드 주소는 bff/.env의 BACKEND_URL
VITE_BFF_PROXY_TARGET=http://localhost:8787

# 토스페이먼츠 클라이언트 키 (예치금 충전 결제창)
VITE_PG_CLIENT_KEY=
