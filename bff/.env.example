# bff/.env로 복사해 써요. pnpm dev가 읽어요(node --env-file-if-exists=.env)
PORT=8787
# 백엔드 주소. 모듈별로 따로 띄우면 MEMBER_API_URL·PRODUCT_API_URL처럼 덮어써요 (src/config.ts)
BACKEND_URL=http://localhost:8080
# 상태를 바꾸는 요청(POST 등)을 받아 줄 Origin. 쉼표로 여러 개
ALLOWED_ORIGINS=http://localhost:5173
# 세션 저장소. 비우면 메모리(재시작하면 로그아웃). 운영(NODE_ENV=production)은 필수예요
# REDIS_URL=redis://localhost:6379
