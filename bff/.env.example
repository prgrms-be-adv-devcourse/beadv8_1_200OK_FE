# bff/.env로 복사해 써요. pnpm dev가 읽어요(node --env-file-if-exists=.env)
PORT=8787
# 백엔드 주소. 모듈별로 따로 띄우면 MEMBER_API_URL·PRODUCT_API_URL처럼 덮어써요 (src/config.ts)
BACKEND_URL=http://localhost:8080
# 상태를 바꾸는 요청(POST 등)을 받아 줄 Origin. 쉼표로 여러 개
ALLOWED_ORIGINS=http://localhost:5173
# Sentry(오류·트레이스·로그). 비우면 보내지 않아요. 값은 Sentry 프로젝트 paldo-bff > Client Keys (DSN)
SENTRY_DSN=
# 트레이스 샘플링 비율(0~1). 비우면 1.0. 잘못된 값은 경고하고 1.0을 써요. /health는 늘 빼요
SENTRY_TRACES_SAMPLE_RATE=
# Sentry release. 이미지는 빌드 때 커밋 SHA가 들어가요(bff/Dockerfile). 로컬은 비워 둬요
SENTRY_RELEASE=
