# bff/.env로 복사해 써요. pnpm dev가 읽어요(node --env-file-if-exists=.env)
PORT=8787
# 백엔드 주소. 모듈별로 따로 띄우면 MEMBER_API_URL·PRODUCT_API_URL처럼 덮어써요 (src/config.ts)
BACKEND_URL=http://localhost:8080
# 상태를 바꾸는 요청(POST 등)을 받아 줄 Origin. 쉼표로 여러 개
ALLOWED_ORIGINS=http://localhost:5173
# multipart가 아닌 요청 본문 상한(바이트, 기본 2MB). 넘으면 413이에요. 업로드는 대상이 아니에요
# 근거: 상품 상세설명 최대 200,000자(한글이면 약 600KB)
REQUEST_BODY_LIMIT_BYTES=2097152
# Sentry(오류·트레이스·로그). 비우면 보내지 않아요. 값은 Sentry 프로젝트 paldo-bff > Client Keys (DSN)
SENTRY_DSN=
# 트레이스 샘플링 비율(0~1). 비우면 1.0. 잘못된 값은 경고하고 1.0을 써요. /health는 늘 빼요
SENTRY_TRACES_SAMPLE_RATE=
# Sentry release. 이미지는 빌드 때 커밋 SHA가 들어가요(bff/Dockerfile). 로컬은 비워 둬요
SENTRY_RELEASE=
# 상품 상세(GET /api/v1/products/{id}) 응답을 BFF 메모리에 두는 시간(ms)과 상한 (ADR-0011). TTL 0이면 담지 않고 동시 요청 합치기만 해요
# 상품 수나 본문 합계(바이트) 중 하나라도 넘으면 가장 오래 안 쓴 상품부터 버려요
PRODUCT_CACHE_TTL_MS=5000
PRODUCT_CACHE_MAX_ENTRIES=500
PRODUCT_CACHE_MAX_BYTES=16777216
