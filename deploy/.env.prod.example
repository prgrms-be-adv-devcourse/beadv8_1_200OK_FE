# 운영 EC2의 /opt/paldo-gotgan-bff/.env 예시. 복사한 뒤 chmod 600 .env

# BFF 이미지 태그. 롤백할 때만 이전 커밋 SHA 7자리로 바꾸고, 고친 뒤 다시 배포할 때 latest로 되돌려요
BFF_IMAGE_TAG=latest

# 상태를 바꾸는 요청을 받아 줄 Origin. 쉼표로 여러 개
ALLOWED_ORIGINS=https://paldo-gotgan-fe.vercel.app

# Sentry paldo-bff 프로젝트 DSN(Settings > Client Keys). 비우면 Sentry로 보내지 않아요
SENTRY_DSN=

# 트레이스 샘플링 비율(0~1). 비우면 1.0(트래픽이 적은 동안). 늘면 낮춰요. 잘못된 값은 경고하고 1.0을 써요
SENTRY_TRACES_SAMPLE_RATE=
